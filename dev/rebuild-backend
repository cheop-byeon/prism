#!/usr/bin/env bash
# Rebuild the local API Docker image and restart backend containers.
# Use this after adding new Python code, dependencies, or config changes.

set -euo pipefail

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
cd "${SCRIPT_DIR}/../docker"

echo "==> Removing old dify-local-api:dev image, dangling images, and build cache..."
docker rmi dify-local-api:dev 2>/dev/null || true
docker image prune -f
docker builder prune -f

echo "==> Building dify-local-api:dev image..."
docker compose \
  -f docker-compose.yaml \
  -f docker-compose.override.yaml \
  build api

echo "==> Recreating backend containers with new image..."
docker compose \
  -f docker-compose.yaml \
  -f docker-compose.override.yaml \
  up -d --force-recreate --no-deps \
  api worker worker_beat || true

# If containers were only Created (not Started) due to init_permissions dep ordering, start them.
docker compose \
  -f docker-compose.yaml \
  -f docker-compose.override.yaml \
  start api worker worker_beat 2>/dev/null || true

echo "==> Waiting for api to be healthy..."
for i in $(seq 1 30); do
  if docker compose \
      -f docker-compose.yaml \
      -f docker-compose.override.yaml \
      exec -T api flask --version >/dev/null 2>&1; then
    echo "    api is up."
    break
  fi
  sleep 2
done

echo "==> Recent api logs:"
docker compose \
  -f docker-compose.yaml \
  -f docker-compose.override.yaml \
  logs --tail=30 api
