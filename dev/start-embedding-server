#!/usr/bin/env bash
# Register the RFC-DRAlign-QN embedding model with the local Ollama service.
#
# Serving contract (validated against the mteb-R2Gen eval wrapper,
# non_verbose_retrieval_mistral_models.py):
#   - exactly ONE trailing EOS  -> tokenizer.ggml.add_eos_token=true (baked in GGUF)
#   - last-token (EOS) pooling  -> llama.pooling_type=LAST (baked in GGUF)
# With both keys in the GGUF, plain Ollama serves it correctly: q8_0 output
# agrees with the fp16 PyTorch reference at cosine 0.985-0.9998
# (reference vectors: ~/Models/rfc-dralign-reference-vecs.json).
#
# Dify model provider (OpenAI-API-compatible, Text Embedding):
#   endpoint: http://host.docker.internal:11434/v1
#   model:    rfc-dralign-q8   (4096 dims)
#
# Ollama itself is an external host service (not part of this repo) — start
# it via the Ollama app or `ollama serve` before running this script.

set -euo pipefail

MODEL_NAME="rfc-dralign-q8"
GGUF="${RFC_DRALIGN_GGUF:-$HOME/Models/rfc-dralign-q8-pooled.gguf}"

if ! curl -s http://localhost:11434/api/version >/dev/null; then
  echo "Ollama is not running — start the Ollama app (or 'ollama serve') first." >&2
  exit 1
fi

if ollama show "$MODEL_NAME" >/dev/null 2>&1; then
  echo "$MODEL_NAME already registered with Ollama"
else
  if [ ! -f "$GGUF" ]; then
    echo "GGUF not found: $GGUF" >&2
    exit 1
  fi
  printf 'FROM %s\n' "$GGUF" | ollama create "$MODEL_NAME" -f -
  echo "$MODEL_NAME created from $GGUF"
fi

curl -s http://localhost:11434/api/embed \
  -d "{\"model\":\"$MODEL_NAME\",\"input\":\"health check\"}" \
  | grep -q embeddings && echo "embedding endpoint OK — Dify endpoint: http://host.docker.internal:11434/v1"
