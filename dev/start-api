#!/bin/bash

set -x
set -euo pipefail

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
cd "$SCRIPT_DIR/../api"

UV_RUNNER=(uv)
if ! command -v uv >/dev/null 2>&1; then
  UV_RUNNER=("/opt/homebrew/bin/python3" -m uv)
fi

"${UV_RUNNER[@]}" run flask db upgrade

"${UV_RUNNER[@]}" run \
  flask run --host 0.0.0.0 --port=5001 --debug
