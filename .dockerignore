# Prism: keep runtime state and secrets out of any build whose context is the
# repo root and has no <Dockerfile>.dockerignore of its own -- docker/volumes/
# holds Postgres/Weaviate data and certbot's root-only Let's Encrypt keys.
docker/volumes/
.env
.env.*
