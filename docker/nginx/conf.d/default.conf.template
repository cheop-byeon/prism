# Please do not directly edit this file. Instead, modify the .env variables related to NGINX configuration.

server {
    listen ${NGINX_PORT};
    server_name ${NGINX_SERVER_NAME};

    location /console/api {
      proxy_pass http://api:5001;
      include proxy.conf;
    }

    location /api {
      proxy_pass http://api:5001;
      include proxy.conf;
    }

    location /v1 {
      proxy_pass http://api:5001;
      include proxy.conf;
    }

    location /files {
      proxy_pass http://api:5001;
      include proxy.conf;
    }

    location /explore {
      proxy_pass http://web:3000;
      include proxy.conf;
    }

    location /e/ {
      proxy_pass http://plugin_daemon:5002;
      proxy_set_header Dify-Hook-Url $scheme://$host$request_uri;
      include proxy.conf;
    }

    # Prism (ietf_decision_agent_ui) -- reverse-proxied instead of its own
    # subdomain. Per explicit direction, /prism must not exist as a
    # human-navigable path at all any more: the real top-level entry points
    # are /spectrum (the redesigned page, port 8766, the primary post-login
    # experience), /classic (the original page, port 8765), and /login (one
    # shared portal for both). Each rewrites its own path segment down to
    # the bare /prism/... path Flask's routes actually understand
    # (PRISM_URL_PREFIX env var -- unchanged internally, still shared by
    # both ports) before proxying, exactly like /prism/classic/ used to
    # strip /classic.
    #
    # /prism/... itself is kept working underneath (see the exact-match
    # redirects below, which take priority over this prefix block
    # regardless of declaration order in nginx) ONLY because both pages'
    # own client-side JS is built with that same PRISM_URL_PREFIX baked
    # into every fetch()/EventSource absolute URL (e.g. /prism/api/models),
    # not derived from whichever top-level path the page itself loaded
    # from -- so it keeps working as invisible plumbing no human is
    # expected to navigate to directly, while the exact-match redirects
    # below send an actual person straight to the new canonical paths.
    location = /spectrum {
      return 301 /spectrum/;
    }

    location /spectrum/ {
      rewrite ^/spectrum/(.*)$ /prism/$1 break;
      proxy_pass http://ietf_decision_agent_ui:8766;
      include proxy.conf;
    }

    location = /classic {
      return 301 /classic/;
    }

    location /classic/ {
      rewrite ^/classic/(.*)$ /prism/$1 break;
      proxy_pass http://ietf_decision_agent_ui:8765;
      include proxy.conf;
    }

    # One shared login portal at the domain root -- no "/prism" repeated in
    # the path, since the domain itself already says prism. Content is
    # identical regardless of which port renders it (see _render_login_page
    # in serve_ui.py -- it doesn't branch on request.host at all), so this
    # rewrites straight to spectrum's own /prism/login. The login page's own
    # post-auth redirect targets a relative /prism/ path (baked in the same
    # way as the API calls above) -- caught by the exact-match /prism/
    # redirect below and sent on to /spectrum/, so no backend template
    # change is needed for that leg either.
    # Dify's own web console uses /signin, not /login, for its own sign-in
    # page (confirmed: web/app/signin exists, web/app/login does not), so
    # this doesn't shadow anything Dify itself needs.
    location = /login {
      rewrite ^/login$ /prism/login break;
      proxy_pass http://ietf_decision_agent_ui:8766;
      include proxy.conf;
    }

    location = /login-hero.jpg {
      rewrite ^/login-hero\.jpg$ /prism/login-hero.jpg break;
      proxy_pass http://ietf_decision_agent_ui:8766;
      include proxy.conf;
    }

    # The bare domain root was falling through to the catch-all `location /`
    # below, which proxies straight to Dify's own web console -- so a
    # fresh, logged-out visitor landed on Dify's stock /signin page instead
    # of the Prism login portal above. login_template.html always renders
    # the login form unconditionally (confirmed: no client- or server-side
    # check for an existing valid session), so an already-authenticated
    # visitor landing here just sees the form again rather than being
    # bounced straight to /spectrum/ -- a minor redundancy, not a loop.
    location = / {
      return 301 /login;
    }

    # /prism itself must never render a page for a real visitor -- these
    # three exact matches intercept the specific paths a person (or an old
    # bookmark/link) could actually land on, ahead of the general /prism/
    # prefix block below (nginx always prefers an exact match over a prefix
    # one, independent of file order) -- everything else under /prism/,
    # namely the API/asset calls the pages' own JS makes, still reaches the
    # backend unredirected.
    location = /prism {
      return 301 /spectrum;
    }

    location = /prism/ {
      return 301 /spectrum/;
    }

    location = /prism/login {
      return 301 /login;
    }

    location = /prism/classic {
      return 301 /classic;
    }

    location = /prism/classic/ {
      return 301 /classic/;
    }

    location /prism/ {
      proxy_pass http://ietf_decision_agent_ui:8766;
      include proxy.conf;
    }

    location / {
      proxy_pass http://web:3000;
      include proxy.conf;
    }

    location /mcp {
      proxy_pass http://api:5001;
      include proxy.conf;
    }

    location /triggers {
      proxy_pass http://api:5001;
      include proxy.conf;
    }
    
    # placeholder for acme challenge location
    ${ACME_CHALLENGE_LOCATION}

    # placeholder for https config defined in https.conf.template
    ${HTTPS_CONFIG}
}
